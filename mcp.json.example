{
  "mcpServers": {
    "zensched": {
      "url": "https://mcp.zensched.com/mcp",
      "headers": {
        "Authorization": "Bearer zsc_your_key_here"
      }
    },
    "radon-db": {
      "command": "npx",
      "args": ["-y", "easy-sqlite-mcp"],
      "env": {
        "SQLITE_PATH": "/ABSOLUTE/PATH/TO/radon/radon.db"
      }
    }
  }
}
